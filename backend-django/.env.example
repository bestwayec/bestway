# Phase 1 local development only. Never commit actual credentials.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/education_center?schema=public
DJANGO_SECRET_KEY=change-me-use-a-long-random-local-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost
FRONTEND_ORIGIN=http://localhost:3000
BUILD_COMMIT=

# Desktop release metadata: manual installer only; no updater signing is advertised.
DESKTOP_LATEST_VERSION=1.0.10
DESKTOP_DOWNLOAD_URL=https://github.com/bestwayec/bw-tauri/releases/download/v1.0.10/Bestway.App_1.0.10_x64-setup.exe
DESKTOP_PRERELEASE=false
ANDROID_LATEST_VERSION=1.0.10
ANDROID_APK_PATH=media/downloads/bestway-app.apk
ANDROID_APK_URL=https://github.com/bestwayec/bw-tauri/releases/download/v1.0.10/bestway-app.apk

# Authentication: JWT_SECRET must match the active backend for a parallel rollout.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
DESKTOP_REDIRECT_URIS=bestway-exam://auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REDIS_URL=
DEEPSEEK_API_KEY=
DEEPGRAM_API_KEY=
STORAGE_DIR=./storage
MEDIA_URL=/media/
PUBLIC_URL=https://api.bestwayec.uz
# External student-data processing is opt-in after provider and privacy review.
ASSESSMENT_EXTERNAL_AI_ALLOWED=false
ASSESSMENT_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EVAL_MODEL=deepseek/deepseek-v4.1-flash-1017:free
# Comma-separated, explicitly approved zero-retention provider slugs.
OPENROUTER_ALLOWED_PROVIDERS=
ASSESSMENT_DAILY_BUDGET=50
ASSESSMENT_MAX_ATTEMPTS=3
ASSESSMENT_PROVIDER_TIMEOUT_MS=90000
ASSESSMENT_STT_TIMEOUT_MS=60000
ASSESSMENT_ALLOW_PAID_FALLBACK=false
ASSESSMENT_PAID_DAILY_REQUESTS=0
ASSESSMENT_PAID_DAILY_BUDGET_MICROUSD=0
ASSESSMENT_FALLBACK_MODEL=
OPENROUTER_MAX_PROMPT_PRICE=
OPENROUTER_MAX_COMPLETION_PRICE=

STT_PROVIDER=groq
GROQ_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
STT_GROQ_FREE_ACCOUNT_APPROVED=false
STT_ALLOW_LOCAL_FALLBACK=false
STT_LOCAL_FALLBACK_MODEL=small.en
# To transcribe offline, set STT_PROVIDER=faster-whisper and STT_MODEL=small.en.
# Prewarm the worker model cache using python manage.py prewarm_local_stt --download.
# Runtime uses the cached model. Recordings stay on the worker.
STT_LOCAL_MODEL_DIR=/app/model-cache
STT_LOCAL_CPU_THREADS=1
STT_LOCAL_BEAM_SIZE=1
STT_LOCAL_MAX_AUDIO_SECONDS=600
STT_LOCAL_TIMEOUT_SECONDS=300
STT_LOCAL_LOCK_TIMEOUT_SECONDS=5
# Keep all model-download caches writable by the unprivileged worker.
HF_HOME=/app/model-cache/huggingface
HF_XET_CACHE=/app/model-cache/huggingface/xet
# Use the regular download transport; Xet is unnecessary for these models.
HF_HUB_DISABLE_XET=1
HF_HUB_DISABLE_TELEMETRY=1
ASSESSMENT_WORKER_ENABLED=true
ASSESSMENT_WORKER_CONCURRENCY=2
ASSESSMENT_ADJUDICATION_ENABLED=false

# Production uses config.settings.production (Docker selects it explicitly).
# Generate DJANGO_SECRET_KEY with at least 50 random characters and JWT_SECRET
# with at least 32. Set DEBUG=false, ALLOWED_HOSTS=api.bestwayec.uz,django-api,backend,
# CORS_ALLOWED_ORIGINS=https://bestwayec.uz,https://www.bestwayec.uz plus the
# desktop origins above. DATABASE_URL must use the existing PostgreSQL schema;
# Docker service DNS is postgres:5432, not 127.0.0.1. URL-encode credentials.
# docker-compose.django.yml supplies REDIS_URL and /app/storage automatically.
# Workers read approved provider and privacy settings from the active backend .env.
TRUST_PROXY_SSL_HEADER=false
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
# Number of trusted proxies that append to X-Forwarded-For (DRF NUM_PROXIES). Throttles and
# per-IP limits use this. Production (Cloudflare -> cloudflared -> Next.js proxy -> Django): the
# Next.js proxy replaces X-Forwarded-For with Cloudflare's CF-Connecting-IP, so set 1.
# 0 (default) = use the socket peer; behind a proxy that makes every user share one bucket.
TRUSTED_PROXY_COUNT=0
# The Django worker profile must not run alongside active Nest schedulers.
# Stop the matching Nest workers before enabling --profile workers.
# Telegram polling is opt-in: --profile telegram-polling. Stop the existing
# polling bot before starting this profile; two bots cannot poll the same token.
# Exam code returned by /v1/exams/active (CD simulator). Missing or not visible -> 404, no fallback.
ACTIVE_CD_EXAM_CODE=MOCK-RECORD-01
TELEGRAM_MODE=off
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_TTL_MINUTES=10
