# Phase 1 local development only. Never commit actual credentials.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/education_center?schema=public
DJANGO_SECRET_KEY=change-me-use-a-long-random-local-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost
FRONTEND_ORIGIN=http://localhost:3000
BUILD_COMMIT=

# Desktop release metadata: manual installer only; no updater signing is advertised.
DESKTOP_LATEST_VERSION=0.5.1-rc.1
DESKTOP_DOWNLOAD_URL=https://github.com/bestwayec/bw-tauri/releases/download/v0.5.1-rc.1/Bestway.App_0.5.1-rc.1_x64-setup.exe
DESKTOP_PRERELEASE=true

# Authentication: JWT_SECRET must match the active backend for a parallel rollout.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
DESKTOP_REDIRECT_URIS=bestway-exam://auth/callback
REDIS_URL=
DEEPSEEK_API_KEY=
DEEPGRAM_API_KEY=
STORAGE_DIR=./storage
MEDIA_URL=/media/
PUBLIC_URL=https://api.bestwayec.uz
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
DEEPSEEK_ADJUDICATOR_MODEL=
STT_PROVIDER=deepgram
STT_API_KEY=
STT_MODEL=
STT_BASE_URL=https://api.deepgram.com/v1
ASSESSMENT_WORKER_ENABLED=true
ASSESSMENT_ADJUDICATION_ENABLED=true

# Production uses config.settings.production (Docker selects it explicitly).
# Generate DJANGO_SECRET_KEY with at least 50 random characters and JWT_SECRET
# with at least 32. Set DEBUG=false, ALLOWED_HOSTS=api.bestwayec.uz,django-api,backend,
# CORS_ALLOWED_ORIGINS=https://bestwayec.uz,https://www.bestwayec.uz plus the
# desktop origins above. DATABASE_URL must use the existing PostgreSQL schema;
# Docker service DNS is postgres:5432, not 127.0.0.1. URL-encode credentials.
# docker-compose.django.yml supplies REDIS_URL and /app/storage automatically.
# Workers need DEEPSEEK/STT provider settings from the active backend .env.
TRUST_PROXY_SSL_HEADER=false
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
TRUSTED_PROXY_COUNT=0
# The Django worker profile must not run alongside active Nest schedulers.
# Stop the matching Nest workers before enabling --profile workers.
# Telegram polling is opt-in: --profile telegram-polling. Stop the existing
# polling bot before starting this profile; two bots cannot poll the same token.
TELEGRAM_MODE=off
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
