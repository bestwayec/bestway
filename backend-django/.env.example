# Phase 1 local development only. Never commit actual credentials.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/education_center?schema=public
DJANGO_SECRET_KEY=change-me-use-a-long-random-local-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost
FRONTEND_ORIGIN=http://localhost:3000
BUILD_COMMIT=

# Desktop release metadata: manual installer only; no updater signing is advertised.
DESKTOP_LATEST_VERSION=0.5.1-rc.1
DESKTOP_DOWNLOAD_URL=https://github.com/bestwayec/bw-tauri/releases/download/v0.5.1-rc.1/Bestway.App_0.5.1-rc.1_x64-setup.exe
DESKTOP_PRERELEASE=true

# Reserved for later migration phases. These are intentionally optional in Phase 1.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
REDIS_URL=
DEEPSEEK_API_KEY=
DEEPGRAM_API_KEY=
STORAGE_DIR=./storage
MEDIA_URL=/media/
