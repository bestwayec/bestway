{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bestway Mock Test Import Package v1.0 (proposed)",
  "description": "Strict structural contract. FORMAT.md defines additional semantic and publish validation. This is not an existing API.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "revision", "profile", "source", "exam", "media", "reviewIssues"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "packageId": { "$ref": "#/definitions/key" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "profile": { "enum": ["practice", "full_mock"] },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "label"],
      "properties": {
        "kind": { "enum": ["provided_material", "original_practice"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 500 },
        "notes": { "type": "string", "maxLength": 2000 }
      }
    },
    "exam": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "title", "description", "level", "isDemo", "price", "isFreeForApproved", "sections"],
      "properties": {
        "type": { "enum": ["ielts_academic", "ielts_general", "multilevel"] },
        "title": { "type": "string", "minLength": 3, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "level": { "type": "string", "maxLength": 50 },
        "practiceLevel": { "enum": [null, "A1", "A2", "B1", "B2", "C1"] },
        "isDemo": { "type": "boolean" },
        "price": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "isFreeForApproved": { "type": "boolean" },
        "sections": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/definitions/section" } }
      }
    },
    "media": { "type": "array", "maxItems": 20, "items": { "$ref": "#/definitions/media" } },
    "reviewIssues": { "type": "array", "maxItems": 200, "items": { "$ref": "#/definitions/issue" } }
  },
  "definitions": {
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,79}$" },
    "answer": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "answers": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/definitions/answer" } },
    "section": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "skill", "title", "instructions", "groups"],
      "properties": {
        "key": { "$ref": "#/definitions/key" },
        "skill": { "enum": ["listening", "reading", "writing", "speaking"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "instructions": { "type": "string", "maxLength": 2000 },
        "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 300 },
        "groups": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/definitions/group" } }
      }
    },
    "group": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "title", "instructions", "passageText", "contentHtml", "contentLayout", "audioScript", "questions"],
      "properties": {
        "key": { "$ref": "#/definitions/key" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "instructions": { "type": "string", "maxLength": 2000 },
        "passageText": { "type": "string", "maxLength": 20000 },
        "contentHtml": { "type": "string", "maxLength": 100000 },
        "contentLayout": { "enum": ["document", "table", "notes", "summary", "sentences", "headings", "speakers", "short_texts", "paragraphs", "map", "multi_extract"] },
        "optionsReusable": { "type": ["boolean", "null"] },
        "audioScript": { "type": "string", "maxLength": 100000 },
        "partNumber": { "type": "integer", "minimum": 1, "maximum": 6 },
        "audioPlayLimit": { "type": "integer", "minimum": 1, "maximum": 10 },
        "audioRef": { "$ref": "#/definitions/key" },
        "imageRef": { "$ref": "#/definitions/key" },
        "questions": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/definitions/question" } }
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "number", "type", "prompt", "options", "correctAnswers", "acceptedVariants", "points", "sourceRef"],
      "properties": {
        "key": { "$ref": "#/definitions/key" },
        "number": { "type": "integer", "minimum": 1, "maximum": 200 },
        "type": { "enum": ["multiple_choice", "multi_select", "true_false_notgiven", "yes_no_notgiven", "matching", "matching_headings", "sentence_completion", "note_completion", "summary_completion", "table_completion", "short_answer", "map_labelling", "essay_task1", "essay_task2", "speaking_task"] },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "options": { "type": "array", "maxItems": 26, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
        "correctAnswers": { "$ref": "#/definitions/answers" },
        "acceptedVariants": { "$ref": "#/definitions/answers" },
        "points": { "type": "integer", "minimum": 1, "maximum": 20 },
        "wordLimit": { "type": "integer", "minimum": 1, "maximum": 50 },
        "answerRule": { "enum": [null, "ONE_WORD", "ONE_WORD_AND_OR_NUMBER"] },
        "sourceRef": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["multiple_choice", "multi_select", "matching", "matching_headings"] } } },
          "then": { "properties": { "options": { "minItems": 2 } } }
        },
        {
          "if": { "properties": { "type": { "enum": ["essay_task1", "essay_task2", "speaking_task"] } } },
          "then": { "properties": { "options": { "maxItems": 0 }, "correctAnswers": { "maxItems": 0 }, "acceptedVariants": { "maxItems": 0 } }, "not": { "required": ["wordLimit"] } },
          "else": { "properties": { "correctAnswers": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "type": { "enum": ["multiple_choice", "matching", "matching_headings"] } } },
          "then": { "properties": { "correctAnswers": { "maxItems": 1, "items": { "type": "string", "pattern": "^[A-Z]$" } }, "acceptedVariants": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "type": { "const": "multi_select" } } },
          "then": { "properties": { "correctAnswers": { "minItems": 2, "items": { "type": "string", "pattern": "^[A-Z]$" } }, "acceptedVariants": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "type": { "const": "true_false_notgiven" } } },
          "then": { "properties": { "options": { "enum": [["TRUE", "FALSE", "NOT GIVEN"], ["TRUE", "FALSE", "NOT_GIVEN"], ["TRUE", "FALSE", "NO_INFORMATION"]] }, "correctAnswers": { "maxItems": 1, "items": { "enum": ["TRUE", "FALSE", "NOT GIVEN", "NOT_GIVEN", "NO_INFORMATION"] } }, "acceptedVariants": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "type": { "const": "yes_no_notgiven" } } },
          "then": { "properties": { "options": { "enum": [["YES", "NO", "NOT GIVEN"], ["YES", "NO", "NOT_GIVEN"], ["YES", "NO", "NO_INFORMATION"]] }, "correctAnswers": { "maxItems": 1, "items": { "enum": ["YES", "NO", "NOT GIVEN", "NOT_GIVEN", "NO_INFORMATION"] } }, "acceptedVariants": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "type": { "enum": ["sentence_completion", "note_completion", "summary_completion", "table_completion", "short_answer"] } } },
          "then": { "properties": { "options": { "maxItems": 0 } } },
          "else": { "if": { "properties": { "type": { "not": { "const": "map_labelling" } } } }, "then": { "not": { "required": ["wordLimit"] } } }
        }
      ]
    },
    "media": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "kind", "fileName", "requiredForPublish"],
      "properties": {
        "key": { "$ref": "#/definitions/key" },
        "kind": { "enum": ["audio", "image"] },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\:]+$" },
        "requiredForPublish": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 500 }
      }
    },
    "issue": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "code", "path", "message", "sourceRef"],
      "properties": {
        "key": { "$ref": "#/definitions/key" },
        "code": { "enum": ["MISSING_ANSWER", "AMBIGUOUS_TEXT", "MISSING_MEDIA", "UNSUPPORTED_LAYOUT", "NUMBERING_REVIEW", "OTHER"] },
        "path": { "type": "string", "maxLength": 1000, "pattern": "^(/([^~/]|~[01])*)*$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "sourceRef": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
