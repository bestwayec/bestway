  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "WeekDay": {
        "enum": [
          "mon",
          "tue",
          "wed",
          "thu",
          "fri",
          "sat",
          "sun"
        ]
      },
      "ScheduleItem": {
        "type": "object",
        "required": [
          "day",
          "startTime",
          "endTime"
        ],
        "properties": {
          "day": {
            "$ref": "#/components/schemas/WeekDay"
          },
          "startTime": {
            "type": "string"
          },
          "endTime": {
            "type": "string"
          }
        }
      },
      "GroupInput": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "teacherId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "schedule": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleItem"
            }
          }
        }
      },
      "GroupListItem": {
        "type": "object",
        "required": [
          "id",
          "name",
          "teacherId",
          "teacherName",
          "schedule",
          "createdAt",
          "studentsCount"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "teacherId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "teacherName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "schedule": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ScheduleItem"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "studentsCount": {
            "type": "number"
          }
        }
      },
      "GroupStudent": {
        "type": "object",
        "required": [
          "studentId",
          "name",
          "isActive",
          "isApproved",
          "currentPoints",
          "completedExamsCount",
          "listeningScore",
          "readingScore",
          "writingScore",
          "speakingScore",
          "overallBand"
        ],
        "properties": {
          "studentId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "isApproved": {
            "type": "boolean"
          },
          "currentPoints": {
            "type": "number"
          },
          "completedExamsCount": {
            "type": "number"
          },
          "listeningScore": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "readingScore": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "writingScore": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "speakingScore": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "overallBand": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "GroupAnalytics": {
        "type": "object",
        "required": [
          "averageBandScore",
          "totalCompletedAttempts"
        ],
        "properties": {
          "averageBandScore": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "totalCompletedAttempts": {
            "type": "number"
          }
        }
      },
      "GroupDetail": {
        "type": "object",
        "required": [
          "id",
          "name",
          "teacherId",
          "teacherName",
          "schedule",
          "createdAt",
          "students",
          "analytics"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "teacherId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "teacherName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "schedule": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ScheduleItem"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "students": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GroupStudent"
            }
          },
          "analytics": {
            "$ref": "#/components/schemas/GroupAnalytics"
          }
        }
      },
      "ApiFailure": {
        "type": "object",
        "required": [
          "success",
          "error"
        ],
        "properties": {
          "success": {
            "const": false
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
