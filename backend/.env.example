# --- Baza ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/education_center?schema=public"

# --- Server ---
PORT=3001
# Frontend manzili (CORS uchun, vergul bilan bir nechta bo'lishi mumkin)
# Tauri desktop originlari backendda avtomatik ruxsat etiladi
# (tauri://localhost, http://tauri.localhost, http://localhost:1420),
# lekin prod web domen(lar)ni shu yerga yozing:
CORS_ORIGIN=http://localhost:3000
# Desktop deep-link qaytish manzillari (vergul bilan ro'yxat).
# Tauri + web + backend uchalasi ham bir xil qiymatni ishlatishi shart.
DESKTOP_REDIRECT_URIS=bestway-exam://auth/callback
# Desktop ilova yangilanish xabarnomasi (GET /v1/desktop-version).
# DESKTOP_LATEST_VERSION hozirgi relizdan katta bo'lsa, student ilovada toast ko'radi.
# downloadUrl bo'sh bo'lsa — faqat xabar chiqadi, "Update now" tugmasi yashiriladi.
DESKTOP_LATEST_VERSION=0.5.1-rc.1
DESKTOP_DOWNLOAD_URL=https://github.com/bestwayec/bw-tauri/releases/download/v0.5.1-rc.1/Bestway.App_0.5.1-rc.1_x64-setup.exe
# RC is a manual installer; it has no Tauri updater signature.
DESKTOP_PRERELEASE=true
# Tashqaridan ko'rinadigan backend manzili (video stream URL yasashda ishlatiladi)
PUBLIC_URL=http://localhost:3001

# --- JWT ---
# PROD: openssl rand -hex 32 — boot fails if <32 chars (see src/main.ts).
# Never use the placeholder below in production.
JWT_SECRET=change-me-generate-32-bytes-minimum-replace-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- Video streaming ---
# PROD: openssl rand -hex 32 — no length gate in code, use 32+ bytes.
STREAM_TOKEN_SECRET=change-me-generate-32-bytes-minimum-replace-in-prod
STREAM_URL_TTL_SECONDS=3600
STORAGE_DIR=./storage
MAX_UPLOAD_MB=500

# --- AI assessment (backend only; leave blank to force manual review) ---
# DeepSeek Responses API. Model names are intentionally required and configurable.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
DEEPSEEK_ADJUDICATOR_MODEL=
ASSESSMENT_POLICY=MANUAL_ONLY
ASSESSMENT_WORKER_ENABLED=true
ASSESSMENT_ADJUDICATION_ENABLED=true
ASSESSMENT_CONFIDENCE_THRESHOLD=0.85
ASSESSMENT_MAX_ATTEMPTS=3
ASSESSMENT_PROVIDER_TIMEOUT_MS=90000
ASSESSMENT_MAX_OUTPUT_TOKENS=8000

# Speech-to-text adapter. Transcript confidence is never pronunciation evidence.
STT_PROVIDER=deepgram
STT_BASE_URL=https://api.deepgram.com/v1
STT_API_KEY=
STT_MODEL=
ASSESSMENT_STT_TIMEOUT_MS=90000

# --- Telegram bot (ixtiyoriy; bo'sh bo'lsa faqat in-app bildirishnoma ishlaydi) ---
# @BotFather dan olinadi
TELEGRAM_BOT_TOKEN=
# Deep link uchun (masalan "bilim_markaz_bot"). Bo'sh bo'lsa getMe orqali aniqlanadi.
TELEGRAM_BOT_USERNAME=
# Bog'lash havolasining amal qilish muddati (daqiqa)
TELEGRAM_LINK_TTL_MINUTES=10
# polling | webhook | off
#   polling — LOCAL va dev (domen/HTTPS shart emas) — hozir shu rejimda ishlang
#   webhook — VPS PROD (HTTPS majburiy) — fresh VPS'da shunga o'ting
#   off — bot butunlay o'chiq
TELEGRAM_MODE=polling
# Faqat webhook rejimi uchun (VPS prod misoli):
# TELEGRAM_MODE=webhook
# TELEGRAM_WEBHOOK_URL=https://api.bestwayec.uz/v1/telegram/webhook
# Tasodifiy uzun satr — Telegram har so'rovda shu qiymatni header'da qaytaradi
# PROD webhook: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# --- Markaz nomi (PDF sertifikatda chiqadi) ---
CENTER_NAME=Bilim O'quv Markazi

# --- Seed (birinchi ishga tushirishda yaratiladigan super admin) ---
# PROD: kuchli parol qo'ying va seed:init dan keyin almashtiring. `seed`/`seed:mock` ni PROD da hech qachon ishlatmang.
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_PHONE=+998900000001
SEED_SUPER_ADMIN_PASSWORD=Super123!
