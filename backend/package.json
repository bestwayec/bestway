{
  "name": "education-center-backend",
  "version": "1.0.0",
  "description": "O'quv markaz platformasi — backend (NestJS + Prisma + PostgreSQL)",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "test": "vitest run",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "seed:init": "ts-node --transpile-only prisma/seed-init.ts",
    "seed:mock": "ts-node --transpile-only prisma/seed-mock.ts",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:timing": "ts-node --transpile-only scripts/verify-timing.ts",
    "test:fulltest-speaking": "ts-node --transpile-only scripts/verify-fulltest-speaking.ts",
    "test:assessment-smoke": "node -r ts-node/register scripts/assessment-provider-smoke.cjs",
    "tg:link": "node scripts/telegram-link.mjs",
    "db:backup": "bash scripts/backup.sh",
    "db:clean-demos": "ts-node --transpile-only prisma/clean-demos.ts",
    "postinstall": "patch-package"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.3.0",
    "@prisma/client": "^5.22.0",
    "@types/sanitize-html": "^2.16.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^18.0.3",
    "helmet": "^8.3.0",
    "multer": "2.4.0",
    "pdfkit": "^0.15.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.8",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "body-parser": "1.20.6",
    "qs": "6.16.0",
    "picomatch": "4.0.4",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "file-type": "21.3.2",
    "glob": "10.5.0",
    "ajv": "8.18.0",
    "webpack": "5.104.1",
    "brace-expansion": "1.1.21",
    "fast-uri": "3.1.8",
    "lodash": "^4.18.1",
    "multer": "2.4.0"
  }
}
