# Frontend environment template (copy to .env.local for local dev).
# Production values are injected by docker-compose (API_URL) — this file is documentation only.
# See backend/.env.example for the backend counterpart.

# Server-only: NestJS base URL reachable FROM the Next.js server container.
# Local dev:
API_URL=http://localhost:3001/v1
# Production (compose sets this — do not hardcode here):
# API_URL=http://backend:3001/v1

# Optional: extra host allowed in next/image remotePatterns (space/comma separated).
NEXT_PUBLIC_MEDIA_HOST=

# Large-file uploads (>~90MB) bypass Cloudflare Free's 100MB proxied cap
# via a DNS-only (grey-cloud) hostname that hits Nginx directly.
# Requires the frontend upload client to POST to this host for big files.
# Small files keep using the default API route (proxied, cached, WAF-protected).
# Local dev: leave empty (direct upload disabled).
UPLOAD_API_HOST=
# Production:
# UPLOAD_API_HOST=https://direct-api.bestwayec.uz

NEXT_PUBLIC_GOOGLE_CLIENT_ID=

